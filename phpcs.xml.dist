<?xml version="1.0"?>
<!-- The code sniffer of the Adobe Commerce Marketplace (Magento2 standard) and PHP 7.4+ compatibility. -->
<ruleset name="CoinsPay">
    <file>.</file>
    <exclude-pattern>*/dist/*</exclude-pattern>
    <exclude-pattern>*/bin/*</exclude-pattern>
    <arg name="extensions" value="php,phtml,xml,js,html,less,css"/>
    <arg value="sp"/>

    <rule ref="Magento2"/>

    <config name="testVersion" value="7.4-"/>
    <rule ref="PHPCompatibility">
        <include-pattern>*\.php$</include-pattern>
        <include-pattern>*\.phtml$</include-pattern>
    </rule>
</ruleset>
