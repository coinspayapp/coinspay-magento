<?xml version="1.0" encoding="UTF-8"?>
<!-- Unit tests of the core, without Magento: composer install in bin/tools first. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="bin/tools/vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="bin/tools/bootstrap.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <testsuite name="core">
            <directory>Test/Unit</directory>
        </testsuite>
    </testsuites>
</phpunit>
